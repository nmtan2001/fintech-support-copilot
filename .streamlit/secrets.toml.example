# Replace with the Hugging Face model repository containing the Kaggle checkpoint.
HF_MODEL_ID = "your-huggingface-username/fintech-support-distilbert"

# Set these only for a private model repository.
# HUGGINGFACE_HUB_TOKEN = "hf_read_token"
# HF_MODEL_REVISION = "main"

# NVIDIA API Catalog key. Without an LLM key, the app answers from the synthetic FAQ.
# NVIDIA_API_KEY = "nvapi-your_key"
# Set this to a model enabled for your NVIDIA API key.
# NVIDIA_MODEL = "your-enabled-nvidia-model-id"
