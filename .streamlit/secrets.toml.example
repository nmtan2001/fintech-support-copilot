# Hosted classification uses the fine-tuned BANKING77 model.
HF_MODEL_ID = "nmtan2001/fintech-support-distilbert"

# HF_TOKEN needs access to the model and Inference Providers permission.
# HF_TOKEN = "your-hf-token"
# HUGGINGFACE_HUB_TOKEN is also accepted.
# HUGGINGFACE_HUB_TOKEN = "hf_read_token"
# For a model served on a dedicated Hugging Face Inference Endpoint:
# HF_INFERENCE_ENDPOINT_URL = "https://your-endpoint.endpoints.huggingface.cloud"
# HF_MODEL_REVISION applies only to local checkpoint loading.
# HF_MODEL_REVISION = "main"

# NVIDIA API Catalog key. Without an LLM key, the app answers from the synthetic FAQ.
# NVIDIA_API_KEY = "nvapi-your_key"
# Set this to a model enabled for your NVIDIA API key.
# NVIDIA_MODEL = "your-enabled-nvidia-model-id"
